# Optional. Copy to .env; never commit credentials.
# Default remains testnet4. Set main explicitly for production mainnet.
EXPLORER_NETWORK=testnet4
EXPLORER_HOST=127.0.0.1
EXPLORER_PORT=3000
# Default database is isolated by network AND current genesis hash.
# Use a NEW path after a chain reset; do not reuse an old chain's index.
# EXPLORER_DATABASE=./data/my-testnet4-v2.sqlite
# Leave unset to select the RPC port by network: main=48172, testnet4=48178.
# An explicit URL overrides that selection, even when EXPLORER_NETWORK changes.
# CONNECTCOIN_RPC_URL=http://127.0.0.1:48172

# Preferred: authenticate with the node's existing cookie.
# CONNECTCOIN_DATADIR=C:/Users/your-user/AppData/Local/ConnectCoin
# Mainnet uses the base data-directory .cookie, without a network subdirectory.
# CONNECTCOIN_RPC_COOKIE=C:/path/to/mainnet-node-data/.cookie
# Testnet4 uses the testnet4 subdirectory instead:
# CONNECTCOIN_RPC_COOKIE=C:/path/to/node/testnet4/.cookie

# Alternative: existing RPC credentials configured on your node.
# CONNECTCOIN_RPC_USER=explorer
# CONNECTCOIN_RPC_PASSWORD=
