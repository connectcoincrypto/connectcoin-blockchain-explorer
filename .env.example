# Optional. Copy to .env; never commit credentials.
EXPLORER_NETWORK=testnet4
EXPLORER_HOST=127.0.0.1
EXPLORER_PORT=3000
# Separate persistent database for each network.
# EXPLORER_DATABASE=./data/testnet4.sqlite
CONNECTCOIN_RPC_URL=http://127.0.0.1:48178

# Preferred: authenticate with the node's existing cookie.
# CONNECTCOIN_DATADIR=C:/Users/your-user/AppData/Local/ConnectCoin
# CONNECTCOIN_RPC_COOKIE=C:/path/to/node/testnet4/.cookie

# Alternative: existing RPC credentials configured on your node.
# CONNECTCOIN_RPC_USER=explorer
# CONNECTCOIN_RPC_PASSWORD=
